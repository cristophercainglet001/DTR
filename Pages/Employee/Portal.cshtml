@page
@model DepEdDTRSystem.Pages.Employee.PortalModel
@{
    ViewData["Title"] = "My DTR";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 no-print">
    <div>
        <p class="text-uppercase text-success fw-semibold small mb-1">Teacher & employee portal</p>
        <h1 class="mb-1">My Daily Time Record</h1>
        <p class="text-secondary mb-0">View your attendance logs and print your monthly Form 48.</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Report is not null)
        {
            <a href="@Model.Report.VerificationUrl" class="btn btn-outline-success">Verify report</a>
        }
        <a asp-page="/Employee/Leave" class="btn btn-outline-secondary">My leave requests</a>
        <button type="button" class="btn btn-primary" onclick="window.print()">Print Form 48</button>
    </div>
</div>

<div class="card mb-4 no-print">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label for="month" class="form-label">Month</label>
                <select id="month" name="month" class="form-select">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month" selected="@(month == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-3">
                <label for="year" class="form-label">Year</label>
                <input id="year" name="year" type="number" min="2000" max="9998" value="@Model.Year" class="form-control" />
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-success">View month</button></div>
        </form>
    </div>
</div>

@if (Model.Report is not null)
{
    <partial name="_DtrForm48" model="Model.Report" />
}

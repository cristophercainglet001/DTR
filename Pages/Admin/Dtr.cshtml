@page
@model DepEdDTRSystem.Pages.Admin.DtrModel
@{
    ViewData["Title"] = "Daily Time Records";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <p class="text-uppercase text-success fw-semibold small mb-1">Attendance</p>
        <h1 class="mb-1">Daily Time Records</h1>
        <p class="text-secondary mb-0">Record and review employee attendance by date.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#dtrFormModal">
        New DTR record
    </button>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

<div class="row g-4 align-items-start">
    <div class="col-xl-8">
        <div class="row g-3 mb-3">
            <div class="col-sm-4">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="small text-secondary">Records shown</div>
                        <div class="fs-3 fw-semibold">@Model.TotalCount</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="small text-secondary">Complete days</div>
                        <div class="fs-3 fw-semibold">@Model.CompleteDayCount</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="small text-secondary">With undertime</div>
                        <div class="fs-3 fw-semibold">@Model.UndertimeRecordCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <div class="mb-3">
                    <h2 class="h4 mb-1">Attendance records</h2>
                    <p class="text-secondary mb-0">Showing records for @Model.FilterDate.ToString("MMMM d, yyyy").</p>
                </div>

                <form method="get" class="row g-2 mb-4">
                    <div class="col-md-5">
                        <label for="dateFilter" class="form-label">Date</label>
                        <input id="dateFilter" name="dateFilter" type="date"
                               value="@Model.FilterDate.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="col-md">
                        <label for="employeeFilter" class="form-label">Employee</label>
                        <select id="employeeFilter" name="employeeFilter" asp-items="Model.EmployeeOptions" class="form-select">
                            <option value="">All employees</option>
                        </select>
                    </div>
                    <div class="col-auto align-self-end">
                        <button type="submit" class="btn btn-outline-success">Apply filters</button>
                    </div>
                </form>

                @if (Model.Records.Count == 0)
                {
                    <div class="text-center py-5">
                        <h3 class="h5">No DTR records for this date</h3>
                        <p class="text-secondary mb-3">Add attendance details using the form.</p>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#dtrFormModal">
                            Enter attendance
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Employee</th>
                                    <th scope="col">AM</th>
                                    <th scope="col">PM</th>
                                    <th scope="col">Undertime</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.Records)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@record.Employee?.LastName, @record.Employee?.FirstName</div>
                                            <div class="small text-secondary">@record.Employee?.EmployeeId · @record.Employee?.School?.SchoolName</div>
                                        </td>
                                        <td class="text-nowrap">@Model.FormatTime(record.AmTimeIn) – @Model.FormatTime(record.AmTimeOut)</td>
                                        <td class="text-nowrap">@Model.FormatTime(record.PmTimeIn) – @Model.FormatTime(record.PmTimeOut)</td>
                                        <td>
                                            @if (record.UndertimeMinutes > 0)
                                            {
                                                <span class="badge text-bg-warning">@record.UndertimeMinutes min</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">—</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-page="/Admin/Dtr"
                                               asp-route-dateFilter="@Model.FilterDate.ToString("yyyy-MM-dd")"
                                               asp-route-employeeFilter="@Model.EmployeeFilter"
                                               asp-route-pageNumber="@Model.PageNumber"
                                               asp-route-editId="@record.Id"
                                               class="btn btn-sm btn-outline-secondary">Edit</a>
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(record.Remarks))
                                    {
                                        <tr class="dtr-remarks-row">
                                            <td colspan="5" class="small text-secondary pt-0">Note: @record.Remarks</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="DTR record pages" class="d-flex justify-content-between align-items-center mt-3">
                            <span class="small text-secondary">Page @Model.PageNumber of @Model.TotalPages</span>
                            <div class="btn-group">
                                @if (Model.PageNumber > 1)
                                {
                                    <a asp-page="/Admin/Dtr"
                                       asp-route-dateFilter="@Model.FilterDate.ToString("yyyy-MM-dd")"
                                       asp-route-employeeFilter="@Model.EmployeeFilter"
                                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                                       class="btn btn-sm btn-outline-secondary">Previous</a>
                                }
                                @if (Model.PageNumber < Model.TotalPages)
                                {
                                    <a asp-page="/Admin/Dtr"
                                       asp-route-dateFilter="@Model.FilterDate.ToString("yyyy-MM-dd")"
                                       asp-route-employeeFilter="@Model.EmployeeFilter"
                                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                                       class="btn btn-sm btn-outline-secondary">Next</a>
                                }
                            </div>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>

    </div>

    <div class="modal fade" id="dtrFormModal" tabindex="-1" aria-labelledby="dtrFormModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h4 mb-1" id="dtrFormModalLabel">@(Model.IsEditing ? "Edit DTR record" : "New DTR record")</h2>
                        <p class="text-secondary small mb-0">Enter the employee's attendance for the selected date.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form method="post" asp-page-handler="Save">
                    <div class="modal-body">
                    <input asp-for="Input.Id" type="hidden" />
                    <input name="dateFilter" value="@Model.FilterDate.ToString("yyyy-MM-dd")" type="hidden" />
                    <input name="employeeFilter" value="@Model.EmployeeFilter" type="hidden" />
                    <input name="pageNumber" value="@Model.PageNumber" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.EmployeeId" class="form-label">Employee <span class="text-danger">*</span></label>
                        <select asp-for="Input.EmployeeId" asp-items="Model.EmployeeOptions" class="form-select">
                            <option value="">Select an employee</option>
                        </select>
                        <span asp-validation-for="Input.EmployeeId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.DtrDate" class="form-label">Attendance date <span class="text-danger">*</span></label>
                        <input asp-for="Input.DtrDate" type="date" class="form-control" />
                        <span asp-validation-for="Input.DtrDate" class="text-danger small"></span>
                    </div>

                    <div class="dtr-time-group mb-3">
                        <h3 class="h6 mb-3">Morning</h3>
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="Input.AmTimeIn" class="form-label small">Time in</label>
                                <input asp-for="Input.AmTimeIn" type="time" class="form-control" />
                                <span asp-validation-for="Input.AmTimeIn" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Input.AmTimeOut" class="form-label small">Time out</label>
                                <input asp-for="Input.AmTimeOut" type="time" class="form-control" />
                                <span asp-validation-for="Input.AmTimeOut" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="dtr-time-group mb-3">
                        <h3 class="h6 mb-3">Afternoon</h3>
                        <div class="row g-2">
                            <div class="col-6">
                                <label asp-for="Input.PmTimeIn" class="form-label small">Time in</label>
                                <input asp-for="Input.PmTimeIn" type="time" class="form-control" />
                                <span asp-validation-for="Input.PmTimeIn" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Input.PmTimeOut" class="form-label small">Time out</label>
                                <input asp-for="Input.PmTimeOut" type="time" class="form-control" />
                                <span asp-validation-for="Input.PmTimeOut" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.UndertimeMinutes" class="form-label">Undertime (minutes)</label>
                        <input asp-for="Input.UndertimeMinutes" type="number" min="0" max="1440" class="form-control" />
                        <span asp-validation-for="Input.UndertimeMinutes" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Input.Remarks" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Input.Remarks" class="text-danger small"></span>
                    </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">@(Model.IsEditing ? "Save changes" : "Save attendance")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.ShowFormModal)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                bootstrap.Modal.getOrCreateInstance(document.getElementById("dtrFormModal")).show();
            });
        </script>
    }
}

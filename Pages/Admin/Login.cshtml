@page
@model DepEdDTRSystem.Pages.Admin.LoginModel
@{
    ViewData["Title"] = "Admin Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Admin Login</h1>

                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="alert alert-success" role="status">@statusMessage</div>
                }
                @if (Model.AdminSetupRequired)
                {
                    <div class="alert alert-warning" role="status">
                        Admin sign-in is not initialized. Configure the first admin account using the secure setup instructions.
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>
                <div class="text-center mt-3">
                    <a asp-page="/Admin/ForgotPassword">Forgot your password?</a>
                </div>
                <a asp-page="/Employee/Login" class="btn btn-outline-secondary w-100 mt-3">Staff sign in</a>
            </div>
        </div>
    </div>
</div>
